generator client {
  provider      = "prisma-client-js"
  // "native" for local dev, "rhel-openssl-3.0.x" for the Lambda (Amazon Linux 2023) runtime
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  avatarUrl      String?
  role           Role      @default(USER)
  googleId       String?   @unique
  cognitoId      String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  comments       Comment[]
  subscriptions  Newsletter[]
  requestLogs    RequestLog[]
  pageViews      PageView[]

  @@map("users")
}

enum Role {
  ADMIN
  USER
}

// ─── Posts ────────────────────────────────────────────────────────────────────

model Post {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  excerpt     String?
  content     String      // rich text / HTML
  coverImage  String?
  status      PostStatus  @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tags        TagsOnPosts[]
  comments    Comment[]
  media       MediaOnPosts[]

  @@map("posts")
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

// ─── Tags ─────────────────────────────────────────────────────────────────────

model Tag {
  id    String        @id @default(cuid())
  name  String        @unique
  slug  String        @unique

  posts TagsOnPosts[]

  @@map("tags")
}

model TagsOnPosts {
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("tags_on_posts")
}

// ─── Comments ─────────────────────────────────────────────────────────────────

model Comment {
  id           String   @id @default(cuid())
  content      String
  approved     Boolean  @default(false)
  isOwnerReply Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId   String
  postId   String
  parentId String?

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@map("comments")
}

// ─── Newsletter ───────────────────────────────────────────────────────────────

model Newsletter {
  id          String             @id @default(cuid())
  email       String             @unique
  status      SubscriptionStatus @default(PENDING)
  confirmedAt DateTime?
  createdAt   DateTime           @default(now())
  blockedAt   DateTime?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("newsletter")
}

enum SubscriptionStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

// ─── Analytics ────────────────────────────────────────────────────────────────
// Raw rows retained 180 days, pruned daily by the broomns-blog-analytics-prune
// Lambda. Registered users only — no anonymous tracking.

model RequestLog {
  id         String   @id @default(cuid())
  userId     String
  method     String
  path       String   // matched route PATTERN (request.routeOptions.url), not the
                      // raw resolved URL — keeps dynamic-id routes aggregable
  statusCode Int
  durationMs Int
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("request_logs")
}

model PageView {
  id         String   @id @default(cuid())
  userId     String
  sessionId  String   // crypto.randomUUID(), one per browser tab session (sessionStorage)
  path       String   // locale-stripped pathname, no query string
  durationMs Int
  createdAt  DateTime @default(now()) // written at flush time (page-LEAVE) — ordering by
                                      // this column reconstructs visit order; "entered at"
                                      // is a display-only createdAt - durationMs

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, sessionId, createdAt])
  @@map("page_views")
}

// ─── Media ────────────────────────────────────────────────────────────────────

model Media {
  id           String   @id @default(cuid())
  filename     String   @unique // stored filename (uuid.ext)
  originalName String   // original upload name
  mimeType     String
  size         Int      // bytes
  url          String   // public URL
  createdAt    DateTime @default(now())

  posts        MediaOnPosts[]
  aboutPages   MediaOnAboutPage[]
  supportPages MediaOnSupportPage[]

  @@map("media")
}

model MediaOnPosts {
  mediaId String
  postId  String

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([mediaId, postId])
  @@map("media_on_posts")
}

// ─── About page ───────────────────────────────────────────────────────────────
// Singleton — exactly one row, seeded by migration. Enforced at the
// application layer (about.repository.ts always reads/updates that one row).

model AboutPage {
  id        String   @id @default(cuid())
  content   String   // rich text / HTML
  updatedAt DateTime @updatedAt

  media MediaOnAboutPage[]

  @@map("about_page")
}

model MediaOnAboutPage {
  mediaId     String
  aboutPageId String

  media     Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  aboutPage AboutPage @relation(fields: [aboutPageId], references: [id], onDelete: Cascade)

  @@id([mediaId, aboutPageId])
  @@map("media_on_about_page")
}

// ─── Support page ─────────────────────────────────────────────────────────────
// Singleton — exactly one row, seeded by migration. Enforced at the
// application layer (support.repository.ts always reads/updates that one row).

model SupportPage {
  id        String   @id @default(cuid())
  content   String   // rich text / HTML
  updatedAt DateTime @updatedAt

  media MediaOnSupportPage[]

  @@map("support_page")
}

model MediaOnSupportPage {
  mediaId       String
  supportPageId String

  media       Media       @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  supportPage SupportPage @relation(fields: [supportPageId], references: [id], onDelete: Cascade)

  @@id([mediaId, supportPageId])
  @@map("media_on_support_page")
}
